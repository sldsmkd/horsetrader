                "$ref": "#/$defs/AnchorRecord"
              },
              {
                "$ref": "#/$defs/AnchoredEventRecord"
              }
            ],
            "discriminator": {
              "propertyName": "type",
              "mapping": {
                "support": "#/$defs/SupportBannerRecord",
                "trainee": "#/$defs/TraineeBannerRecord",
                "scenario": "#/$defs/ScenarioRecord",
                "story": "#/$defs/StoryRecord",
                "cm": "#/$defs/CMRecord",
                "anchor": "#/$defs/AnchorRecord",
                "anchoredevent": "#/$defs/AnchoredEventRecord"
              }
            }
          }
        }
      },
      "required": [
        "events"
      ]
    },
