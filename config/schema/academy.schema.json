{
  "$ref": "#/$defs/Academy",
  "$defs": {
    "Academy": {
      "title": "Academy",
      "description": "Top-level shape of ``academy.json`` — the entity collections, each a\nstable-key → record map (the keys are the collection class names lowercased,\nmatching ``Bake.academy``).",
      "type": "object",
      "properties": {
        "characters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/CharacterRecord"
          }
        },
        "courses": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/CourseRecord"
          }
        },
        "races": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/RaceRecord"
          }
        },
        "racetracks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/RacetrackRecord"
          }
        },
        "supports": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SupportRecord"
          }
        },
        "trainees": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/TraineeRecord"
          }
        }
      },
      "required": [
        "characters",
        "courses",
        "races",
        "racetracks",
        "supports",
        "trainees"
      ]
    },
    "CharacterRecord": {
      "title": "CharacterRecord",
      "type": "object",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "portrait": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "bio": {
          "$ref": "#/$defs/BioRecord"
        }
      },
      "required": [
        "name",
        "quote",
        "icon",
        "portrait",
        "bio"
      ]
    },
    "BioRecord": {
      "title": "BioRecord",
      "description": "A character's vital-statistics bundle. Every member is optional: not all\ncharacters carry this (NPCs never had it, or umapyoi hasn't filled it in).\n`three_sizes` is always the container with nullable members; `birthday` /\n`height` (cm) are `null` wholesale when absent.",
      "type": "object",
      "properties": {
        "three_sizes": {
          "$ref": "#/$defs/ThreeSizesRecord"
        },
        "birthday": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/BirthdayRecord"
            }
          ]
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "three_sizes",
        "birthday",
        "height"
      ]
    },
    "ThreeSizesRecord": {
      "title": "ThreeSizesRecord",
      "type": "object",
      "properties": {
        "bust": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "waist": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "hips": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "bust",
        "waist",
        "hips"
      ]
    },
    "BirthdayRecord": {
      "title": "BirthdayRecord",
      "type": "object",
      "properties": {
        "month": {
          "type": "integer"
        },
        "day": {
          "type": "integer"
        }
      },
      "required": [
        "month",
        "day"
      ]
    },
    "CourseRecord": {
      "title": "CourseRecord",
      "type": "object",
      "properties": {
        "racetrack": {
          "type": "string"
        },
        "surface": {
          "type": "string"
        },
        "distance": {
          "type": "integer"
        },
        "variant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagram": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "racetrack",
        "surface",
        "distance",
        "variant",
        "diagram"
      ]
    },
    "RaceRecord": {
      "title": "RaceRecord",
      "type": "object",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "grade": {
          "type": "string"
        },
        "surface": {
          "type": "string"
        },
        "distance": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "racetrack": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "banner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "grade",
        "surface",
        "distance",
        "racetrack",
        "banner"
      ]
    },
    "RacetrackRecord": {
      "title": "RacetrackRecord",
      "type": "object",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "icon"
      ]
    },
    "SupportRecord": {
      "title": "SupportRecord",
      "type": "object",
      "properties": {
        "character": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "display": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "rarity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "release": {
          "type": "string"
        },
        "thumbnail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "art": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "character",
        "display",
        "type",
        "rarity",
        "title",
        "release",
        "thumbnail",
        "art",
        "aliases",
        "source"
      ]
    },
    "TraineeRecord": {
      "title": "TraineeRecord",
      "type": "object",
      "properties": {
        "character": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "rarity": {
          "type": "integer"
        },
        "release": {
          "type": "string"
        },
        "thumbnail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "portrait": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "aptitudes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/AptitudesRecord"
            }
          ]
        }
      },
      "required": [
        "character",
        "variant",
        "title",
        "rarity",
        "release",
        "thumbnail",
        "portrait",
        "aliases",
        "source",
        "aptitudes"
      ]
    },
    "AptitudesRecord": {
      "title": "AptitudesRecord",
      "description": "A trainee's base aptitudes across all three axes. Each grade is a rank\n*slug* (`\"g\"` … `\"s\"`) — the front-end maps it to both the displayed letter\nand the `--ht-colour-aptitude-*` token. The whole object is `null` when the\nsource page carried no aptitude block.",
      "type": "object",
      "properties": {
        "surface": {
          "$ref": "#/$defs/SurfaceAptitudesRecord"
        },
        "distance": {
          "$ref": "#/$defs/DistanceAptitudesRecord"
        },
        "strategy": {
          "$ref": "#/$defs/StrategyAptitudesRecord"
        }
      },
      "required": [
        "surface",
        "distance",
        "strategy"
      ]
    },
    "SurfaceAptitudesRecord": {
      "title": "SurfaceAptitudesRecord",
      "type": "object",
      "properties": {
        "turf": {
          "type": "string"
        },
        "dirt": {
          "type": "string"
        }
      },
      "required": [
        "turf",
        "dirt"
      ]
    },
    "DistanceAptitudesRecord": {
      "title": "DistanceAptitudesRecord",
      "type": "object",
      "properties": {
        "short": {
          "type": "string"
        },
        "mile": {
          "type": "string"
        },
        "medium": {
          "type": "string"
        },
        "long": {
          "type": "string"
        }
      },
      "required": [
        "short",
        "mile",
        "medium",
        "long"
      ]
    },
    "StrategyAptitudesRecord": {
      "title": "StrategyAptitudesRecord",
      "type": "object",
      "properties": {
        "front": {
          "type": "string"
        },
        "pace": {
          "type": "string"
        },
        "late": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      },
      "required": [
        "front",
        "pace",
        "late",
        "end"
      ]
    }
  }
}