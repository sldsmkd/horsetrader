{
  "name": "horsetrader-site",
  "private": true,
  "scripts": {
    "gen:types": "node scripts/gen-types.mjs",
    "dev": "cp index.html ../static/ && esbuild js/src/main.js --bundle --sourcemap --outfile=../static/js/app.js --serve=localhost:3000 --servedir=../static",
    "build": "cp index.html ../static/ && esbuild js/src/main.js --bundle --minify --outfile=../static/js/app.js",
    "deploy": "wrangler pages deploy ../static"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "json-schema-to-typescript": "^15.0.4",
    "wrangler": "^4.0.0"
  }
}
