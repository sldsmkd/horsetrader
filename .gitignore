.claude/*
.copilot/*
.agents/*
.codex/*
.codex.local/*
.codex.local.md

# Python
venv/
__pycache__/
*.py[cod]

# Node / frontend build tooling (horsetrader.site)
node_modules/
.wrangler/
.dev.vars

# Local config
.env
.env.*

# Legacy tree being ported from
_horsetrader.old/

# VSCode workspace settings
*.code-workspace

# Shippable build artifact — built into, deployed to Cloudflare (regenerated).
# Anchored to repo root so it ignores only the build output, NOT the
# `horsetrader/extractors/static/` package (an unanchored `static/` matched
# any dir of that name and silently dropped new files there).
/static/

# .cache for caching data
.cache/

# Local analysis output — generated reports, not source.
/reports/

# scratcpad
scratch.txt
/scratch/
