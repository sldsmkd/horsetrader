# Tooling
.claude/*
# ...but the agent memory IS tracked: it's repo knowledge, portable to other tools.
# The global auto-memory path (~/.claude/projects/.../memory) is a symlink to here.
!.claude/memory/

# Python
venv/
__pycache__/
*.py[cod]

# Node / frontend build tooling (horsetrader.site)
node_modules/
.wrangler/

# Local config
.env

# Legacy tree being ported from
_horsetrader.old/

# VSCode workspace settings
*.code-workspace

# Shippable build artifact — built into, deployed to Cloudflare (regenerated)
static/

# .cache for caching data
.cache/